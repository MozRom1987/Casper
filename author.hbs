{{!< default}} {{!-- author.hbs — Author page with Sidebar --}} <main id="main" class="page-content author-page">
    <div class="grid-container grid-large">

        {{!-- Author Header --}}
        {{#author}}
        <div class="page-header author-header bg-box">
            <div class="epcl-flex">
                {{#if profile_image}}
                <div class="author-avatar">
                    <img src="{{img_url profile_image size=" m"}}" alt="{{name}}" class="circle" loading="lazy" />
                </div>
                {{/if}}
                <div class="author-info">
                    <h1 class="title large">{{name}}</h1>
                    {{#if bio}}<p>{{bio}}</p>{{/if}}
                    {{#if location}}<p class="location"><i class="fa fa-map-marker"></i> {{location}}</p>{{/if}}
                    <div class="epcl-social-buttons fill-color">
                        {{#if website}}<a href="{{website}}" class="web" target="_blank" rel="noopener noreferrer"><i
                                class="fa fa-globe"></i></a>{{/if}}
                        {{#if twitter}}<a href="https://twitter.com/{{twitter}}" class="twitter" target="_blank"
                            rel="nofollow noopener"><svg>
                                <use xlink:href="#twitter-icon"></use>
                            </svg></a>{{/if}}
                        {{#if facebook}}<a href="https://www.facebook.com/{{facebook}}" class="facebook" target="_blank"
                            rel="nofollow noopener"><i class="fa fa-facebook"></i></a>{{/if}}
                    </div>
                    <p class="post-count">{{plural ../pagination.total empty="No posts" singular="% post" plural="%
                        posts"}}</p>
                </div>
            </div>
        </div>
        {{/author}}

        <div class="epcl-row" style="margin-top: 30px;">

            {{!-- Posts (70%) --}}
            <div class="grid-70 tablet-grid-100 mobile-grid-100" id="content">
                <section class="articles classic">

                    {{#foreach posts}}
                    {{> "post-card"}}
                    {{/foreach}}

                </section>

                {{#if pagination}}
                <nav class="pagination" role="navigation">
                    <div class="pagination-wrapper epcl-flex">
                        {{#if pagination.prev}}
                        <a class="prev epcl-button dark" href="{{page_url pagination.prev}}">&laquo; Newer</a>
                        {{/if}}
                        <span class="page-number">Page {{pagination.page}} of {{pagination.pages}}</span>
                        {{#if pagination.next}}
                        <a class="next epcl-button dark" href="{{page_url pagination.next}}">Older &raquo;</a>
                        {{/if}}
                    </div>
                </nav>
                {{/if}}
            </div>

            {{!-- Sidebar --}}
            {{> "sidebar"}}

        </div>
    </div>
    </main>