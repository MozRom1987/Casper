<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>

    {{!-- Basic meta --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="MobileOptimized" content="320" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {{!-- Groovy CSS --}}
    <link rel="stylesheet" type="text/css" href='{{asset "css/plugins.min.css"}}' />
    <link rel="stylesheet" type="text/css" href='{{asset "css/screen.css"}}' />
    {{!-- NeiroBook overrides --}}
    <link rel="stylesheet" type="text/css" href='{{asset "css/neiro.css"}}' />

    {{!-- Google Fonts: Jost + Outfit --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Outfit:wght@400;700;800&display=swap"
        rel="stylesheet">

    {{!-- Tag & category colors --}}
    <style>
        :root {
            --epcl-background-color: #004D40;
            --epcl-content-background-color: #ffffff;
        }

            {
                {
                #get "tags" limit="all"
            }
        }

            {
                {
                #foreach tags
            }
        }

        .ctag- {
                {
                slug
            }
        }

            {
            --ctag-color: {
                    {
                    #if accent_color
                }
            }

                {
                    {
                    accent_color
                }
            }

                {
                    {
                    else
                }
            }

            var(--main-color) {
                    {
                    /if
                }
            }

            ;
        }

        .ctag- {
                {
                slug
            }
        }

        svg {
            fill: {
                    {
                    #if accent_color
                }
            }

                {
                    {
                    accent_color
                }
            }

                {
                    {
                    else
                }
            }

            var(--main-color) {
                    {
                    /if
                }
            }

            !important;
        }

        .ctag- {
                {
                slug
            }
        }

        .epcl-category-overlay {
            background: {
                    {
                    #if accent_color
                }
            }

                {
                    {
                    accent_color
                }
            }

                {
                    {
                    else
                }
            }

            #fff {
                    {
                    /if
                }
            }

            ;
        }

        .ctag- {
                {
                slug
            }
        }

        .epcl-category-overlay:before {
            background: {
                    {
                    #if accent_color
                }
            }

                {
                    {
                    accent_color
                }
            }

                {
                    {
                    else
                }
            }

            var(--main-color) {
                    {
                    /if
                }
            }

            ;
        }

        .main-article.primary-tag- {
                {
                slug
            }
        }

        .epcl-category-overlay {
            background: {
                    {
                    #if accent_color
                }
            }

                {
                    {
                    accent_color
                }
            }

                {
                    {
                    else
                }
            }

            #fff {
                    {
                    /if
                }
            }

            ;
        }

        .main-article.primary-tag- {
                {
                slug
            }
        }

        .epcl-category-overlay:before {
            background: {
                    {
                    #if accent_color
                }
            }

                {
                    {
                    accent_color
                }
            }

                {
                    {
                    else
                }
            }

            var(--main-color) {
                    {
                    /if
                }
            }

            ;
        }

            {
                {
                /foreach
            }
        }

            {
                {
                /get
            }
        }

        #header.is-sticky div.menu-wrapper .bg-box {
            box-shadow: none;
        }

        #author .author-avatar .author-image {
            border-radius: 100%;
        }
    </style>

    <script>
        var site_url = '{{@site.url}}';
        var theme_config = {
            masonry: 'on',
            sticky_sidebar: 'on',
            disqus_shortname: ''
        };
    </script>

    {{ghost_head}}

</head>

<body class="{{body_class}}">

    {{!-- SVG Icons sprite --}}
    {{> "svg-icons"}}

    {{!-- Mobile Navigation --}}
    <nav class="mobile main-nav hide-on-desktop-lg">
        <ul class="menu">
            {{#foreach @site.navigation}}
            <li class="nav-{{slug}}{{#if current}} current-menu-item{{/if}}"><a href="{{url}}">{{label}}</a></li>
            {{/foreach}}
            <li class="nav-get-access">
                {{#unless @member}}
                <a href="/subscribe">Get Access</a>
                {{/unless}}
            </li>
            <li class="nav-login">
                {{#unless @member}}
                <a href="#/portal/signin">Sign In</a>
                {{else}}
                <a href="#/portal/account">My Account</a>
                {{/unless}}
            </li>
        </ul>
    </nav>
    <div class="menu-overlay hide-on-desktop-lg"></div>

    {{!-- Main wrapper --}}
    <div id="wrapper">

        {{!-- Header --}}
        <header id="header" class="enable-sticky">

            <div class="menu-mobile">
                <svg class="icon ularge open">
                    <use xlink:href="#menu-icon"></use>
                </svg>
                <svg class="icon ularge close">
                    <use xlink:href="#close-icon"></use>
                </svg>
            </div>

            <div class="menu-wrapper">
                <div class="grid-container">
                    <div class="bg-box">
                        {{!-- Logo --}}
                        <div class="logo">
                            <a href="{{@site.url}}">
                                {{#if @site.logo}}
                                <img src="{{@site.logo}}" alt="{{@site.title}}" />
                                {{else}}
                                <span class="title">{{@site.title}}</span>
                                {{/if}}
                            </a>
                        </div>

                        {{!-- Search --}}
                        <a href="javascript:void(0)" data-ghost-search class="epcl-search-button button circle dark">
                            <svg class="icon">
                                <use xlink:href="#search-icon"></use>
                            </svg>
                        </a>

                        {{!-- Desktop nav --}}
                        <nav class="main-nav">
                            <ul class="menu">
                                {{#foreach @site.navigation}}
                                <li class="nav-{{slug}}{{#if current}} current-menu-item{{/if}}"><a
                                        href="{{url}}">{{label}}</a></li>
                                {{/foreach}}
                                <li class="nav-get-access">
                                    {{#unless @member}}
                                    <a href="/subscribe">Get Access</a>
                                    {{/unless}}
                                </li>
                                <li class="nav-login">
                                    {{#unless @member}}
                                    <a href="#/portal/signin">Sign In</a>
                                    {{else}}
                                    <a href="#/portal/account">My Account</a>
                                    {{/unless}}
                                </li>
                            </ul>
                        </nav>

                        <div class="clear"></div>
                    </div>
                    <div class="clear"></div>
                </div>
            </div>
            <div class="clear"></div>
        </header>

        {{{body}}}

        {{!-- Footer --}}
        <footer id="footer">

            <div class="widgets grid-container grid-large hide-on-mobile">
                <div class="epcl-row">

                    {{!-- About widget --}}
                    <section class="widget widget_text bg-box grid-33 tablet-grid-50 mobile-grid-100">
                        <div class="logo">
                            <a href="{{@site.url}}">
                                {{#if @site.logo}}
                                <img src="{{@site.logo}}" alt="{{@site.title}}" width="170" />
                                {{else}}
                                <span class="title">{{@site.title}}</span>
                                {{/if}}
                            </a>
                        </div>
                        <div class="textwidget">
                            {{#if @site.description}}<p>{{@site.description}}</p>{{/if}}
                        </div>
                        <div class="clear"></div>
                    </section>

                    {{!-- Latest articles widget --}}
                    <div class="widget widget_epcl_posts_thumbs bg-box grid-33 tablet-grid-50 mobile-grid-100">
                        <h4 class="widget-title title medium bordered">Latest Articles</h4>
                        {{#get "posts" limit="4"}}
                        {{#foreach posts}}
                        <article class="item ctag-{{primary_tag.slug}}">
                            <div class="info">
                                {{#if feature_image}}
                                <a href="{{url}}" class="thumb main-effect epcl-loader">
                                    <span class="fullimage cover lazy"
                                        data-src='{{img_url feature_image size="s"}}'></span>
                                    <span class="epcl-number">{{@number}}</span>
                                </a>
                                {{/if}}
                                <div class="right">
                                    <h4 class="title usmall underline-effect"><a href="{{url}}">{{title}}</a></h4>
                                    <time datetime='{{date format="YYYY-MM-DD"}}'>{{date format="MMM DD, YYYY"}}</time>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </article>
                        {{/foreach}}
                        {{/get}}
                    </div>

                    {{!-- Tags widget --}}
                    <div class="widget bg-box grid-33 tablet-grid-50 mobile-grid-100">
                        <h4 class="widget-title title medium bordered">Categories</h4>
                        {{#get "tags" limit="10"}}
                        <div class="widget_tag_cloud">
                            {{#foreach tags}}
                            <a href="{{url}}" class="ctag ctag-{{slug}}" data-id="ctag-{{slug}}">
                                <svg>
                                    <use xlink:href="#tag-decoration"></use>
                                </svg>{{name}}
                            </a>
                            {{/foreach}}
                        </div>
                        {{/get}}
                    </div>

                </div>
            </div>

            {{!-- NeiroBook: Final CTA --}}
            <div class="neiro-footer-cta">
                <div class="grid-container grid-usmall" style="text-align:center;">
                    <h3>Ready to Replace Screen Time with Something Better?</h3>
                    <p style="color:rgba(255,255,255,0.8);margin-bottom:28px;">117+ activities. Zero prep. Start today.
                    </p>
                    <a href="/subscribe" class="neiro-btn-coral" style="font-size:18px;padding:16px 44px;">Get Instant
                        Access →</a>
                    <p class="neiro-fine-print">
                        All sales are final. &nbsp;·&nbsp;
                        <a href="/terms">Terms</a> &nbsp;·&nbsp;
                        <a href="/privacy">Privacy</a>
                    </p>
                </div>
            </div>

            {{!-- NeiroBook: Free Preview Lessons --}}
            {{#get "posts" filter="tag:preview" limit="3"}}
            {{#if posts}}
            <div class="neiro-preview-lessons grid-container grid-usmall">
                <h4 style="text-align:center;color:var(--neiro-teal);margin-bottom:20px;">Try a Free Lesson 👇</h4>
                <div class="neiro-preview-grid">
                    {{#foreach posts}}
                    <a href="{{url}}" class="neiro-preview-card">
                        {{#if feature_image}}<img src="{{img_url feature_image size=" s"}}" alt="{{title}}">{{/if}}
                        <span>{{title}}</span>
                    </a>
                    {{/foreach}}
                </div>
            </div>
            {{/if}}
            {{/get}}

            {{!-- NeiroBook: Category Tag Pills --}}
            {{#get "tags" filter="slug:[motor,cognitive,breathing,stretches]" limit="all"}}
            {{#if tags}}
            <div class="neiro-tag-filter grid-container grid-usmall" style="text-align:center;padding:24px 20px;">
                {{#foreach tags}}
                <a href="{{url}}" class="neiro-tag-pill">{{name}}</a>
                {{/foreach}}
            </div>
            {{/if}}
            {{/get}}

            {{!-- Copyright --}}
            <div class="published textcenter" style="padding: 20px 0;">
                <p>&copy; {{date format="YYYY"}} <a href="{{@site.url}}">{{@site.title}}</a>. Powered by <a
                        href="https://ghost.org" target="_blank">Ghost</a>.</p>
            </div>

            {{!-- Secondary navigation --}}
            {{#if @site.secondary_navigation}}
            <nav class="secondary-nav textcenter" style="padding-bottom: 20px;">
                <ul>
                    {{#foreach @site.secondary_navigation}}
                    <li><span class="sep"></span><a href="{{url}}">{{label}}</a></li>
                    {{/foreach}}
                </ul>
            </nav>
            {{/if}}

            {{!-- Back to top --}}
            <a id="back-to-top" href="#" title="Back to top">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                    <path d="M12 4l-8 8h5v8h6v-8h5z" />
                </svg>
            </a>

        </footer>

    </div>

    <div class="body-decorations"></div>

    {{!-- Groovy JS --}}
    <script src='{{asset "js/groovy.js"}}'></script>

    {{ghost_foot}}

</body>

</html>