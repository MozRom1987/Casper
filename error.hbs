{{!< default}} {{!-- error.hbs — 404 and error pages --}} <main id="main" class="page-content error-page">
    <div class="grid-container textcenter">
        <div class="bg-box" style="padding: 80px 40px; margin: 60px auto; max-width: 600px; border-radius: 15px;">
            <h1 class="title" style="font-size: 120px; margin: 0; color: var(--main-color);">{{statusCode}}</h1>
            <h2 class="title large">{{message}}</h2>
            {{#if statusCode}}
            {{#is "404"}}
            <p>Looks like the page you were looking for doesn't exist or has been moved.</p>
            {{else}}
            <p>There was an error loading this page. Please try again later.</p>
            {{/is}}
            {{/if}}
            <a href="{{@site.url}}" class="epcl-button dark" style="margin-top: 20px; display: inline-block;">
                &larr; Back to Home
            </a>
        </div>
    </div>
    </main>