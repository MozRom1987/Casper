{{!< default}} <main id="home" class="main grid-container">

    {{!-- ==========================================================
    ROW 1: HERO пост (66%) + PROBLEM секція (33%)
    Однакова висота через flexbox (.neiro-hero-row)
    ========================================================== --}}
    <div class="epcl-row neiro-hero-row">

        {{!-- HERO — пост з тегом "featured" --}}
        {{#get "posts" filter="tag:featured" limit="1"}}
        {{#foreach posts}}
        <div class="grid-66 tablet-grid-100 mobile-grid-100 neiro-hero-wrap">
            <article class="bg-box neiro-hero-article">

                {{!-- Зображення --}}
                {{#if feature_image}}
                <a href="{{url}}" class="neiro-hero-thumb main-effect epcl-loader">
                    <span class="fullimage cover lazy" data-src='{{img_url feature_image size="l"}}'></span>
                    {{#if primary_tag}}
                    <div class="tags">
                        <a href="{{primary_tag.url}}" class="ctag ctag-{{primary_tag.slug}}">
                            <svg>
                                <use xlink:href="#tag-decoration"></use>
                            </svg>{{primary_tag.name}}
                        </a>
                    </div>
                    {{/if}}
                </a>
                {{/if}}

                {{!-- Текст блок --}}
                <div class="neiro-hero-info">
                    <time datetime="{{date format=" YYYY-MM-DD"}}">{{date format="MMM DD, YYYY"}}</time>
                    <h2 class="title large">
                        <a href="{{url}}">{{title}}</a>
                    </h2>
                    {{#if excerpt}}
                    <p class="post-excerpt">{{excerpt words="20"}}...</p>
                    {{/if}}
                    <a href="{{url}}" class="epcl-button white active">
                        Continue Reading <svg class="icon">
                            <use xlink:href="#right-arrow"></use>
                        </svg>
                    </a>
                </div>

            </article>
        </div>
        {{/foreach}}
        {{/get}}

        {{!-- PROBLEM — статична секція (33%) --}}
        <div class="grid-33 tablet-grid-100 mobile-grid-100 neiro-problem-wrap">
            <section class="neiro-problem bg-box">
                <span class="neiro-problem-emoji">🛑</span>
                <h2>Stop the Screen-Time Guilt.</h2>
                <p>Let's be honest: giving your child a tablet often feels like a trade-off
                    between 15 minutes of peace and their development. But it doesn't have to be.</p>
                <p>No more zombie mode scrolling. Just active, purposeful movement and logic.</p>
                <a href="/subscribe" class="neiro-btn-coral">Get Instant Access →</a>
            </section>
        </div>

    </div>
    {{!-- END ROW 1 --}}

    {{!-- ==========================================================
    ROW 2: 3 пости (без тегу featured)
    ========================================================== --}}
    <div class="articles grid-posts epcl-row neiro-posts-row">
        {{#get "posts" filter="tag:-featured" limit="3"}}
        {{#foreach posts}}
        {{> "post-card-grid"}}
        {{/foreach}}
        {{/get}}
    </div>
    {{!-- END ROW 2 --}}

    {{pagination}}

    {{!-- ==========================================================
    ROW 3: PILLARS — 3 картки (Motor / Cognitive / Breathing)
    ========================================================== --}}
    <section class="neiro-pillars">
        <div class="grid-container">
            <h2 class="neiro-section-title">Three Pillars of Child Development</h2>
            <p class="neiro-section-subtitle">Every activity targets one or more of these core growth areas.</p>
            <div class="neiro-pillars-grid">
                <div class="neiro-pillar-card">
                    <span class="neiro-pillar-icon">🏃</span>
                    <h3>Motor &amp; Movement</h3>
                    <p>52 activities that build coordination, balance, and gross motor skills through dynamic play.</p>
                </div>
                <div class="neiro-pillar-card">
                    <span class="neiro-pillar-icon">🧠</span>
                    <h3>Cognitive Challenges</h3>
                    <p>29 games that sharpen focus, memory, and problem-solving — no screens required.</p>
                </div>
                <div class="neiro-pillar-card">
                    <span class="neiro-pillar-icon">❤️</span>
                    <h3>Breathing &amp; Calm</h3>
                    <p>26 breathing and mindfulness exercises for self-regulation and emotional balance.</p>
                </div>
            </div>
        </div>
    </section>

    {{!-- ==========================================================
    ROW 4: WHAT'S INSIDE — 4 чекбокси
    ========================================================== --}}
    <section class="neiro-inside">
        <div class="grid-container">
            <h2 class="neiro-section-title">What's Inside the Academy</h2>
            <div class="neiro-inside-grid">
                <div class="neiro-inside-item">
                    <span class="neiro-inside-icon">🎬</span>
                    <strong>117+ Videos</strong>
                    <p>Short, engaging activities your child can do right now.</p>
                </div>
                <div class="neiro-inside-item">
                    <span class="neiro-inside-icon">⚡</span>
                    <strong>Zero Prep</strong>
                    <p>No materials, no setup. Just press play and join in.</p>
                </div>
                <div class="neiro-inside-item">
                    <span class="neiro-inside-icon">🧒</span>
                    <strong>Independent Play</strong>
                    <p>Designed for ages 2–5 to follow along independently.</p>
                </div>
                <div class="neiro-inside-item">
                    <span class="neiro-inside-icon">♾️</span>
                    <strong>Lifetime Access</strong>
                    <p>Pay once. Access forever. New content added regularly.</p>
                </div>
            </div>
        </div>
    </section>

    {{!-- ==========================================================
    ROW 5: BONUS — Mustard Gold card
    ========================================================== --}}
    <section class="neiro-bonus">
        <div class="grid-container">
            <div class="neiro-bonus-card">
                <div class="neiro-bonus-left">
                    <span class="neiro-bonus-label">🎁 FREE BONUS</span>
                    <h2>30+ Activity Cards — Included With Your Order</h2>
                    <p>Printable, full-color cards for offline play. Each card covers one activity so kids can follow
                        along without a screen.</p>
                </div>
                <div class="neiro-bonus-right">
                    <a href="/subscribe" class="neiro-btn-coral">Claim Your Bonus →</a>
                </div>
            </div>
        </div>
    </section>

    {{!-- ==========================================================
    ROW 6: SOCIAL PROOF — цитата Sarah M.
    ========================================================== --}}
    <section class="neiro-social-proof">
        <div class="grid-container grid-usmall">
            <div class="neiro-quote-card">
                <div class="neiro-stars">⭐⭐⭐⭐⭐</div>
                <blockquote>
                    "My daughter asks to do her 'brain games' every morning now. She went from constant meltdowns to
                    being able to self-regulate in just three weeks. This is not just an app — it's a complete shift in
                    how we start our day."
                </blockquote>
                <cite>— Sarah M., mom of a 4-year-old</cite>
            </div>
        </div>
    </section>

    {{!-- ==========================================================
    ROW 7: FAQ — HTML accordion
    ========================================================== --}}
    <section class="neiro-faq">
        <div class="grid-container grid-usmall">
            <h2 class="neiro-section-title">Frequently Asked Questions</h2>

            <details class="neiro-faq-item">
                <summary>What age is NeiroBook designed for?</summary>
                <div class="neiro-faq-body">
                    <p>NeiroBook is designed for children ages 2–5. All activities are age-appropriate and can be done
                        independently or with a parent. No reading required — kids simply follow along with the video.
                    </p>
                </div>
            </details>

            <details class="neiro-faq-item">
                <summary>Do I need any special equipment?</summary>
                <div class="neiro-faq-body">
                    <p>No equipment needed! All activities use only your child's body and everyday household items. The
                        focus is on movement, breathing, and cognitive play — not toys or materials.</p>
                </div>
            </details>

            <details class="neiro-faq-item">
                <summary>How is this different from YouTube videos?</summary>
                <div class="neiro-faq-body">
                    <p>YouTube is passive entertainment. NeiroBook is structured, purposeful movement with a
                        developmental goal behind every activity. No ads, no rabbit holes — just focused learning
                        through play.</p>
                </div>
            </details>

            <div class="neiro-faq-cta">
                <a href="/subscribe" class="neiro-btn-coral">Get Instant Access →</a>
            </div>
        </div>
    </section>

    </main>