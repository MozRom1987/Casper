{{!< default}} {{!-- page.hbs — Static Page (no sidebar, full width content) --}} <main id="main"
    class="page-content page-template">
    <div class="grid-container grid-usmall">

        <article id="single" class="main-article {{post_class}}">

            {{!-- Page Header - respects @page.show_title_and_feature_image --}}
            {{#if @page.show_title_and_feature_image}}
            <div class="post-header bg-box {{#unless feature_image}}no-image{{/unless}}">
                {{#if feature_image}}
                <img src="{{feature_image}}" alt="{{title}}" class="page-cover" loading="lazy" />
                {{/if}}
                <div class="info">
                    <h1 class="title large post-title">{{title}}</h1>
                    {{#if custom_excerpt}}<p class="excerpt">{{custom_excerpt}}</p>{{/if}}
                </div>
            </div>
            {{else}}
            <div class="post-header bg-box no-image">
                <div class="info">
                    <h1 class="title large post-title">{{title}}</h1>
                    {{#if custom_excerpt}}<p class="excerpt">{{custom_excerpt}}</p>{{/if}}
                </div>
            </div>
            {{/if}}

            {{!-- Page Body --}}
            <div class="post-content bg-box">
                <div class="epcl-post-body gh-content">
                    {{content}}
                </div>
            </div>

        </article>

    </div>
    </main>