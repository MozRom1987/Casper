<article class="bg-box default classic-large primary-cat-4 grid-100 tablet-grid-100 {{post_class}}">
    <div class="post-format-image epcl-flex">
        {{#if feature_image}}
        <div class="featured-image">    
            <a href="{{url}}" class="thumb epcl-loader main-effect medium-shadow">   
                <span class="fullimage cover lazy" data-src="{{img_url feature_image size="m"}}"></span>  
            </a>
            <div class="meta absolute">
                <a href="{{url}}#comments" class="comments meta-info icon mobile tooltip"><svg><use xlink:href="#comments-icon"></use></svg></a>  
            </div>    
        </div>
        {{/if}}

        <div class="info">   
            <header> 
                <div class="meta epcl-flex">
                    {{#if primary_tag}}
                        <div class="tags">
                            <a href="{{primary_tag.url}}" class="ctag ctag-{{primary_tag.slug}}"><svg><use xlink:href="#tag-decoration"></use></svg>{{primary_tag.name}}</a>
                        </div>
                    {{/if}}
                    <time class="meta-info" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM DD, YYYY"}}</time>  
                    {{#if reading_time}}
                        <div class="min-read meta-info hide-on-tablet"><svg class="icon"><use xlink:href="#calendar"></use></svg> {{reading_time}}</div>
                    {{/if}}
                    <div class="clear"></div>
                </div>
                <h1 class="main-title title large underline-effect"><a href="{{url}}">{{title}}</a></h1>
            </header>

            {{#if excerpt}}
            <div class="post-excerpt">
                <p>{{excerpt words="30"}}...</p>               
            </div>
            {{/if}}

            <footer class="bottom epcl-flex">
                <div class="meta bottom">
                    <a href="{{url}}" class="continue-reading epcl-button white active">Continue Reading <svg><use xlink:href="#right-arrow"></use></svg></a>
                    {{#if primary_author}}
                        <a href="{{primary_author.url}}" title="{{primary_author.name}}" class="author meta-info hide-on-mobile hide-on-tablet hide-on-desktop-sm">                                        
                            {{#if primary_author.profile_image}}
                                <span class="author-image cover lazy" data-src="{{img_url primary_author.profile_image size="xs"}}"></span>                       
                            {{/if}}
                            <span class="author-name">{{primary_author.name}}</span>
                        </a>
                    {{/if}}
                </div>
            </footer>
        </div>   
    </div>
    <div class="clear"></div>
    <div class="epcl-category-overlay"></div>
</article>
