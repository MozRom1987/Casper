{{!< default}} {{!-- post.hbs — Single Post (Groovy classic layout) --}} <main id="main" class="page-content single">
    <div class="grid-container grid-large">
        <div class="epcl-row">

            {{!-- Post Content (70% width) --}}
            <div class="grid-70 tablet-grid-100 mobile-grid-100">

                <article id="single" class="main-article primary-tag-{{primary_tag.slug}} {{post_class}}">

                    {{!-- Post Header --}}
                    <div class="post-header bg-box epcl-flex no-wrap {{#unless feature_image}}no-image{{/unless}}">

                        {{!-- Featured Image --}}
                        {{#if feature_image}}
                        <div class="thumb epcl-loader">
                            <img src="{{img_url feature_image size=" m"}}" alt="{{title}}" class="cover"
                                loading="lazy" />
                            {{#if primary_tag}}
                            <div class="epcl-category-overlay">
                                <a href="{{primary_tag.url}}" class="epcl-category">
                                    {{primary_tag.name}}
                                </a>
                            </div>
                            {{/if}}
                        </div>
                        {{/if}}

                        {{!-- Post Meta / Title --}}
                        <div class="info">
                            <h1 class="title large post-title">{{title}}</h1>
                            {{#if custom_excerpt}}<p class="excerpt">{{custom_excerpt}}</p>{{/if}}

                            <div class="meta epcl-flex">
                                {{#if primary_author}}
                                <div class="author epcl-flex">
                                    {{#if primary_author.profile_image}}
                                    <a href="{{primary_author.url}}" class="avatar epcl-loader">
                                        <img src="{{img_url primary_author.profile_image size=" xs"}}"
                                            alt="{{primary_author.name}}" />
                                    </a>
                                    {{/if}}
                                    <div class="author-info">
                                        <span class="label">By</span>
                                        <a href="{{primary_author.url}}" class="name">{{primary_author.name}}</a>
                                    </div>
                                </div>
                                {{/if}}
                                <span class="date">
                                    <svg class="icon usmall">
                                        <use xlink:href="#calendar"></use>
                                    </svg>
                                    <time datetime="{{date format=" YYYY-MM-DD"}}">{{date format="MMM DD, YYYY"}}</time>
                                </span>
                                {{#if reading_time}}
                                <span class="reading-time">{{reading_time}} min read</span>
                                {{/if}}
                            </div>

                            {{!-- Tags --}}
                            {{#if tags}}
                            <div class="tags">
                                {{#foreach tags}}
                                <a href="{{url}}" class="ctag ctag-{{slug}}">
                                    {{name}}
                                </a>
                                {{/foreach}}
                            </div>
                            {{/if}}

                            {{!-- Membership badge --}}
                            {{#unless access}}
                            <div class="epcl-membership-badge">
                                <svg class="icon">
                                    <use xlink:href="#locked"></use>
                                </svg>
                                Members only
                            </div>
                            {{/unless}}
                        </div>

                        <div class="clear"></div>
                    </div>

                    {{!-- Post Body --}}
                    <div class="post-content bg-box">

                        {{!-- Membership paywall --}}
                        {{#unless access}}
                        <div class="epcl-paywall">
                            <div class="epcl-paywall-content textcenter">
                                <svg class="icon xlarge">
                                    <use xlink:href="#locked"></use>
                                </svg>
                                <h3>This content is for members only.</h3>
                                <p>Join our newsletter to get access to exclusive content.</p>
                                <a href="#/portal/signup" class="epcl-button dark">Become a member</a>
                                <span style="display:inline-block;width:10px;"></span>
                                <a href="#/portal/signin" class="epcl-button">Sign in</a>
                            </div>
                        </div>
                        {{/unless}}

                        <div class="epcl-post-body gh-content">
                            {{content}}
                        </div>

                    </div>

                    {{!-- Social Share --}}
                    <div class="post-share bg-box">
                        <h4 class="title usmall">Share this post:</h4>
                        <div class="epcl-social-buttons fill-color">
                            <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute=" true"}}"
                                class="facebook" target="_blank" rel="nofollow noopener">
                                <i class="fa fa-facebook"></i> Facebook
                            </a>
                            <a href="https://twitter.com/intent/tweet?url={{url absolute=" true"}}&text={{encode
                                title}}" class="twitter" target="_blank" rel="nofollow noopener">
                                <svg>
                                    <use xlink:href="#twitter-icon"></use>
                                </svg> X / Twitter
                            </a>
                        </div>
                    </div>

                    {{!-- Author Box --}}
                    {{#foreach authors}}
                    <div id="author" class="bg-box">
                        <div class="epcl-flex">
                            {{#if profile_image}}
                            <div class="author-avatar">
                                <a href="{{url}}" class="author-image epcl-loader">
                                    <img src="{{img_url profile_image size=" s"}}" alt="{{name}}" loading="lazy" />
                                </a>
                            </div>
                            {{/if}}
                            <div class="author-info">
                                <h4 class="title medium"><a href="{{url}}">{{name}}</a></h4>
                                {{#if bio}}<p>{{bio}}</p>{{/if}}
                                {{#if website}}<a href="{{website}}" class="epcl-button dark small" target="_blank"
                                    rel="noopener noreferrer">Website</a>{{/if}}
                            </div>
                        </div>
                        <div class="clear"></div>
                    </div>
                    {{/foreach}}

                    {{!-- Related Articles --}}
                    {{#get "posts" filter="tags:[{{primary_tag.slug}}]+id:-{{id}}" limit="3"}}
                    {{#if posts}}
                    <section class="related-articles bg-box">
                        <h3 class="title medium bordered">Related Articles</h3>
                        <div class="epcl-row">
                            {{#foreach posts}}
                            <div class="grid-33 tablet-grid-50 mobile-grid-100">
                                <article class="main-article vertical-card primary-tag-{{primary_tag.slug}}">
                                    {{#if feature_image}}
                                    <a href="{{url}}" class="thumb epcl-loader">
                                        <span class="fullimage cover lazy" data-src="{{img_url feature_image size="
                                            s"}}"></span>
                                        <span class="epcl-category-overlay">
                                            {{#if primary_tag}}
                                            <a href="{{primary_tag.url}}" class="epcl-category">
                                                {{primary_tag.name}}
                                            </a>
                                            {{/if}}
                                        </span>
                                    </a>
                                    {{/if}}
                                    <div class="info">
                                        <h3 class="title small"><a href="{{url}}" class="underline-effect">{{title}}</a>
                                        </h3>
                                        <time datetime="{{date format=" YYYY-MM-DD"}}">{{date format="MMM DD,
                                            YYYY"}}</time>
                                    </div>
                                </article>
                            </div>
                            {{/foreach}}
                        </div>
                    </section>
                    {{/if}}
                    {{/get}}

                    {{!-- Previous / Next Post --}}
                    <nav class="post-navigation epcl-flex bg-box">
                        {{#prev_post}}
                        <a href="{{url}}" class="prev-post">
                            <span class="label">&laquo; Previous</span>
                            <span class="title usmall">{{title}}</span>
                        </a>
                        {{/prev_post}}
                        {{#next_post}}
                        <a href="{{url}}" class="next-post">
                            <span class="label">Next &raquo;</span>
                            <span class="title usmall">{{title}}</span>
                        </a>
                        {{/next_post}}
                    </nav>

                    {{!-- Ghost Comments --}}
                    {{#if comments}}
                    <section class="post-comments bg-box">
                        {{comments}}
                    </section>
                    {{/if}}

                </article>

            </div>

            {{!-- Sidebar --}}
            {{> "sidebar"}}

        </div>
    </div>
    </main>
