{{!< default}} {{!-- tag.hbs — Tag Archive with Sidebar --}} <main id="main" class="page-content tag-page">
    <div class="grid-container grid-large">

        {{!-- Tag Header --}}
        {{#tag}}
        <div class="page-header bg-box textcenter">
            {{#if feature_image}}
            <div class="tag-cover" style="background-image: url({{feature_image}});"></div>
            {{/if}}
            <div class="tag-info">
                <h1 class="title large">
                    
                    {{name}}
                </h1>
                {{#if description}}<p>{{description}}</p>{{/if}}
                <p class="post-count">{{plural ../pagination.total empty="No posts" singular="% post" plural="% posts"}}
                </p>
            </div>
        </div>
        {{/tag}}

        <div class="epcl-row" style="margin-top: 30px;">

            {{!-- Posts (70% width) --}}
            <div class="grid-70 tablet-grid-100 mobile-grid-100" id="content">
                <section class="articles classic" id="articles-list">

                    {{#foreach posts}}
                    {{> "post-card"}}
                    {{/foreach}}

                </section>

                {{!-- Pagination --}}
                {{#if pagination}}
                <nav class="pagination" role="navigation">
                    <div class="pagination-wrapper epcl-flex">
                        {{#if pagination.prev}}
                        <a class="prev epcl-button dark" href="{{page_url pagination.prev}}">
                            &laquo; Newer Posts
                        </a>
                        {{/if}}
                        <span class="page-number">Page {{pagination.page}} of {{pagination.pages}}</span>
                        {{#if pagination.next}}
                        <a class="next epcl-button dark" href="{{page_url pagination.next}}">
                            Older Posts &raquo;
                        </a>
                        {{/if}}
                    </div>
                </nav>
                {{/if}}

            </div>

            {{!-- Sidebar --}}
            {{> "sidebar"}}

        </div>
    </div>
    </main>
